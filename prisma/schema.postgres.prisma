/// status: PENDING | ACTIVE | SUSPENDED | REJECTED  (activation is decided by the platform owner only)
model Business {
  id           String    @id @default(cuid())
  publicId     String    @unique
  name         String
  status       String    @default("PENDING")
  contactPhone String?
  contactNote  String?
  activatedAt  DateTime?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  users         User[]
  phones        PhoneNumber[]
  wallets       BusinessWallet[]
  rawMessages   RawMessage[]
  transfers     Transfer[]
  notifications Notification[]
  auditLogs     AuditLog[]
  licenses      License[]
  installations Installation[]
  devices       Device[]
}

/// status: PENDING | ACTIVE | SUSPENDED | EXPIRED
model License {
  id          String    @id @default(cuid())
  key         String    @unique
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        String    @default("أساسية")
  status      String    @default("ACTIVE")
  maxPhones   Int       @default(5)
  maxUsers    Int       @default(10)
  maxDevices  Int       @default(3)
  issuedAt    DateTime  @default(now())
  activatedAt DateTime?
  expiresAt   DateTime?
  lastCheckAt DateTime?
  note        String?
  issuedById  String?

  installations Installation[]
  devices       Device[]

  @@index([businessId])
}

/// A deployment of Wasel software at the client (on-site server, desktop notifier install…). status: ACTIVE | BLOCKED
model Installation {
  id         String    @id @default(cuid())
  publicId   String    @unique
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  licenseId  String?
  license    License?  @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  name       String
  status     String    @default("ACTIVE")
  appVersion String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  devices Device[]

  @@index([businessId])
}

